.DS_Store

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# transient preview images only — deliberate artefacts are committed.
# The reference card is provenance: card_id and print_batch are bound into every
# record, so a verifier may need to know exactly what a batch looked like.
/*.png
docs/preview-*.png

# Never commit signing keys, even development ones
*.pem

# Dart
dart/**/.dart_tool/
dart/**/build/
