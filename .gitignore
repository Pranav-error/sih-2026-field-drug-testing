.DS_Store

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# transient preview images only — deliberate artefacts are committed.
# The reference card is provenance: card_id and print_batch are bound into every
# record, so a verifier may need to know exactly what a batch looked like.
/*.png
docs/preview-*.png

# Never commit signing keys, even development ones
*.pem

# Dart
dart/**/.dart_tool/
dart/**/build/

# Flutter
app/build/
app/.dart_tool/
app/.flutter-plugins*
app/**/local.properties
app/**/GeneratedPluginRegistrant.*

# Third-party spectral measurements: CC BY-NC-SA 4.0, fetched not vendored.
# python core/tools/fetch_spectral_data.py
data/spectral/*.txt

app/build/
